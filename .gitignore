# ==============================================================================
# TeleMind - Master .gitignore
# Node.js, NestJS, Next.js, pnpm, Prisma, Docker, OS & IDE Artefacts
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
.pnp/
.pnp.js

# Build Outputs & Bundles
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
*.swp
*.bak

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
docker-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# Prisma & Database Local Storage
prisma/migrations/dev.db
*.sqlite
*.sqlite3
*.db
pgdata/
redisdata/

# Docker Local Mounts & Overrides
docker-compose.override.yml
.docker/

# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Directories (Keep .vscode shared config, ignore user states)
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.ipr
*.iws

# Sensitive VS Code states
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Temporary Files & Scratch
tmp/
temp/
scratch/
*.pid
*.seed
*.lock

# TeleMind File Uploads (Local Cache)
uploads/
storage/
temp_uploads/
