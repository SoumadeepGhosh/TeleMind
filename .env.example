# ==============================================================================
# TeleMind Environment Variables Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Copy this file to .env before starting the services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=TeleMind
APP_VERSION=0.1.0-alpha.0
TZ=UTC
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3001,https://telemind.example.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=telemind_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password_min_32_chars
POSTGRES_DB=telemind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=10

# ------------------------------------------------------------------------------
# 3. REDIS & CACHE CONFIGURATION (BullMQ & Caching)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_min_32_chars
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Bot tokens are entered by each workspace owner in Dashboard > Telegram & WhatsApp.
# They are encrypted in the integrations table and are not configured in this file.

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95

# ------------------------------------------------------------------------------
# 6. SECURITY, JWT & ENCRYPTION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_secure_jwt_secret_key_at_least_64_characters_long
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_secure_jwt_refresh_secret_at_least_64_characters
JWT_REFRESH_EXPIRATION=7d
DATA_ENCRYPTION_KEY=replace_with_32_byte_aes_hex_key_for_encrypting_stored_tokens
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 7. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Log Levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_CONSOLE_PRETTY=true
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=./logs/telemind.log
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ENABLE_METRICS=true

# ------------------------------------------------------------------------------
# 8. FILE STORAGE (Local / S3 / MinIO Compatible)
# ------------------------------------------------------------------------------
# Drivers: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# S3 / MinIO Configuration (Applicable when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=telemind-documents
S3_ACCESS_KEY=replace_with_s3_or_minio_access_key
S3_SECRET_KEY=replace_with_s3_or_minio_secret_key
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 9. QUEUE & WORKER CONFIGURATION (BullMQ)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
QUEUE_MESSAGE_INGESTION=telemind:telegram:ingest
QUEUE_DOCUMENT_INDEXING=telemind:rag:indexing
QUEUE_AI_GENERATION=telemind:ai:generate
QUEUE_NOTIFICATION=telemind:notifications

# ------------------------------------------------------------------------------
# 10. RATE LIMITING & THROTTLING
# ------------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
TELEGRAM_USER_RATE_LIMIT_MSG_PER_MINUTE=20
